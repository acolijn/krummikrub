# Host nginx reverse-proxy → krummikrub docker container.
# Two layouts below — pick ONE. Subpath layout is what logit-xams.nl uses
# (https://logit-xams.nl/krummikrub). Build the image with
# BASE_PATH=/krummikrub/ to match.

# ── Subpath layout: https://your.domain/krummikrub ──────────────────────
# Drop this `location` block into the existing server { } that serves your
# domain (don't create a new server block — your existing TLS / certbot
# config already terminates HTTPS for the domain).
#
# location /krummikrub/ {
#     # Trailing slash on proxy_pass strips "/krummikrub/" before forwarding,
#     # so the container nginx serves the SPA from its own root.
#     proxy_pass http://127.0.0.1:5173/;
#     proxy_http_version 1.1;
#     proxy_set_header Host              $host;
#     proxy_set_header X-Real-IP         $remote_addr;
#     proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
# }
# # Counter backend (finished-games tally). Longest-prefix match wins, so
# # this takes precedence over /krummikrub/ for /krummikrub/api/* paths.
# location /krummikrub/api/ {
#     proxy_pass http://127.0.0.1:5174/;
#     proxy_http_version 1.1;
#     proxy_set_header Host              $host;
#     proxy_set_header X-Real-IP         $remote_addr;
#     proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
# }
# # Redirect bare /krummikrub → /krummikrub/ (so relative asset URLs resolve).
# location = /krummikrub { return 301 /krummikrub/; }

# ── Root-domain layout: https://krummikrub.your.domain ──────────────────
# Build the image with BASE_PATH=/ (the default in docker-compose unless
# overridden), then use a dedicated server block:
#
# server {
#     listen 80;
#     listen [::]:80;
#     server_name krummikrub.example.com;
#
#     location / {
#         proxy_pass http://127.0.0.1:5173;
#         proxy_http_version 1.1;
#         proxy_set_header Host              $host;
#         proxy_set_header X-Real-IP         $remote_addr;
#         proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#     }
# }
